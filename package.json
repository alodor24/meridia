{
  "name": "meridia",
  "version": "1.0.0",
  "private": true,
  "description": "Meridia — aplicación web de finanzas personales",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @meridia/shared",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace=@meridia/api",
    "dev:web": "npm run dev --workspace=@meridia/web",
    "build": "npm run build -w @meridia/shared && npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "db:create": "node database/db-create.mjs",
    "db:migrate": "node database/migrate.mjs up",
    "db:migrate:down": "node database/migrate.mjs down"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
