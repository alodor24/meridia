# ── Aplicación ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Base de datos (PostgreSQL / Supabase) ──────────────────
# Local:  postgresql://alodor:meridia_dev@localhost:5432/meridia_db
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://alodor:meridia_dev@localhost:5432/meridia_db
PG_SSL=false

# ── JWT / Seguridad ────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cookies ────────────────────────────────────────────────
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_NAME=meridia_refresh

# ── Rate limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
